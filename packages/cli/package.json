{
  "name": "@monolith/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "monolith": "./bin/monolith.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/live/**",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live"
  },
  "dependencies": {
    "@monolith/cloudflare": "workspace:*",
    "@monolith/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
