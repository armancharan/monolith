{
  "name": "@monolith/cli",
  "version": "0.2.0",
  "description": "Monolith CLI — TypeScript IaC for Cloudflare Workers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armancharan/monolith.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "monolith": "./bin/monolith.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/live/**",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live"
  },
  "dependencies": {
    "@monolith/cloudflare": "workspace:*",
    "@monolith/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
