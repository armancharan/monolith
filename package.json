{
  "name": "monolith",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript IaC for Cloudflare Workers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armancharan/monolith.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.run.json",
    "test": "pnpm --filter @monolith/core test && pnpm --filter @monolith/cloudflare test && pnpm --filter @monolith/cli test && pnpm --filter create-monolith test && pnpm --filter @monolith/hono test && pnpm --filter @monolith/effect test",
    "test:integration": "pnpm --filter @monolith/cli test:integration",
    "test:live": "pnpm --filter @monolith/cli test:live",
    "monolith": "node packages/cli/bin/monolith.js",
    "create-monolith": "node packages/create-monolith/bin/create-monolith.js"
  },
  "devDependencies": {
    "@monolith/cloudflare": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
